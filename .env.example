# Defaults run the local managed lab. Keep secrets in your untracked .env.
GOVERNOR_MODE=lab
GOVERNOR_RUNTIME_DIR=.runtime
PROMETHEUS_URL=http://127.0.0.1:9090
PROMETHEUS_PRODUCTION_JOB=governor-production
PROMETHEUS_BEARER_TOKEN=
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cardinality-governor
GOVERNOR_SERIES_BUDGET=400
GOVERNOR_APPROVAL_TIMEOUT=300
GOVERNOR_OBSERVATION_SECONDS=8
GOVERNOR_OPTIONAL_METRICS=["checkout_debug_events_total"]
GOVERNOR_MONITOR=false
GOVERNOR_API_TOKEN=
# Environment files are not auto-loaded by the native CLI; export chosen values.
